# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PostgreSQL (used by docker-compose)
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=telegram_bot

# Database URL
# For Docker: leave commented — docker-compose sets it automatically
# For local dev: uncomment and adjust
# DATABASE_URL=postgresql://bot_user:changeme@localhost:5432/telegram_bot

# AI Providers (add the ones you want to use)
# At least one text generation provider is required

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# xAI Grok (optional)
# GROK_API_KEY=your-grok-api-key-here

# DeepSeek (optional)
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# YouTube Data API (optional) — enriches shared video links with title,
# channel, views, duration and top comments. Without it the link-comments
# feature still runs but has no metadata to comment on.
# https://console.cloud.google.com/apis/credentials
# YOUTUBE_API_KEY=your-youtube-api-key-here

# Bot Settings
# NB: LOG_LEVEL here is NOT read by the bot — the log level comes from
# `logging.level` in config/default.yml. Kept only because docker-compose
# passes the whole file through; changing it has no effect.
LOG_LEVEL=INFO

# -------------------------------------------------------------------
# Database backups (docs/backups.md)
#
# Off by default. Turn on once you have (a) an age key pair and (b) an rclone
# remote — both one-time, both covered step by step in docs/backups.md.
# -------------------------------------------------------------------
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE_UTC=03:30          # daily, UTC (avoids the DST double-run trap)

# The age PUBLIC key. Safe to keep here — it can only encrypt.
# The PRIVATE half belongs in your password manager and NOWHERE ELSE: it is the
# only thing that can read these backups, and also the only thing that can lose
# them. Several keys may be listed, space-separated, to rotate without a gap.
# BACKUP_AGE_RECIPIENT=age1qqqq...

# Where the encrypted dumps go. "backup" must match the remote name spelled out
# in the RCLONE_CONFIG_BACKUP_* variables below.
# BACKUP_REMOTE=backup:telegram-chat-companion

# BACKUP_RETENTION_DAYS=30           # local copies
# BACKUP_REMOTE_RETENTION_DAYS=30    # copies on the remote (defaults to the above)
# BACKUP_MIN_KEEP=3                  # never prune below this many, however old

# --- rclone remote, configured entirely through the environment --------------
# No rclone.conf is used or mounted: this keeps the Drive token travelling the
# same path as every other secret here, instead of needing a file mount that the
# deploy harness would refuse. Produce these values by running `rclone config`
# ONCE on a machine with a browser, then copying them out of its rclone.conf.
#
# Use scope=drive.file — it keeps the token away from the rest of your Drive.
# CAVEAT, measured 2026-08-02: drive.file does NOT isolate one OAuth client from
# another in the same Google Cloud project — a brand-new client could read files
# uploaded earlier by a different client of the same project. For a stolen
# production token to be unable to touch your other backups, give it its own
# Google Cloud PROJECT. See docs/backups.md.
#
# NOTE: rclone will log "Failed to save new token in config file" on refresh.
# That warning is expected and harmless; the refresh token is long-lived and
# each run derives its own access token. Verified end to end against Drive.
# RCLONE_CONFIG_BACKUP_TYPE=drive
# RCLONE_CONFIG_BACKUP_SCOPE=drive.file
# RCLONE_CONFIG_BACKUP_CLIENT_ID=...apps.googleusercontent.com
# RCLONE_CONFIG_BACKUP_CLIENT_SECRET=...
# RCLONE_CONFIG_BACKUP_TOKEN={"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}

# -------------------------------------------------------------------
# Manual QA / live-testing environment (optional; NOT needed for prod)
#
# If you run the browser-based QA suites under tests/manual/, set these
# to the numeric IDs of your own test bot + chats. Leave commented out
# otherwise. Never commit real values — keep them in .env only.
# -------------------------------------------------------------------
# DEV_BOT_ID=
# TEST_ADMIN_USER_ID=
# TEST_CHAT_GENERAL=
# TEST_CHAT_ALT=
# TEST_CHAT_FORUM=
