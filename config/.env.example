# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PostgreSQL (used by docker-compose)
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=telegram_bot

# Database URL
# For Docker: leave commented — docker-compose sets it automatically
# For local dev: uncomment and adjust
# DATABASE_URL=postgresql://bot_user:changeme@localhost:5432/telegram_bot

# AI Providers (add the ones you want to use)
# At least one text generation provider is required

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# xAI Grok (optional)
# GROK_API_KEY=your-grok-api-key-here

# DeepSeek (optional)
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Bot Settings
LOG_LEVEL=INFO

# -------------------------------------------------------------------
# Manual QA / live-testing environment (optional; NOT needed for prod)
#
# If you run the browser-based QA suites under tests/manual/, set these
# to the numeric IDs of your own test bot + chats. Leave commented out
# otherwise. Never commit real values — keep them in .env only.
# -------------------------------------------------------------------
# DEV_BOT_ID=
# TEST_ADMIN_USER_ID=
# TEST_CHAT_GENERAL=
# TEST_CHAT_ALT=
# TEST_CHAT_FORUM=
