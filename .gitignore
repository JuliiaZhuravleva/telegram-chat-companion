# ===========================================
# INTERNAL / MIGRATION FILES (not for public)
# ===========================================

# Project instructions (internal use only)
CLAUDE.md

# Per-session handoff snapshots (timestamped or plain; regenerated each session)
HANDOFF.md
HANDOFF-*.md

# PM registries (internal coordination, not for public repo)
_registry.md
# Glob, not the literal name: the ledger was split by priority on 2026-08-24
# (_tech-debt-backlog.md / _tech-debt-archive.md, see agent_docs/task-pool-design.md),
# which moved ~85% of the content out of the one ignored filename and into two
# tracked ones -- carrying real Telegram ids and absolute paths with it. gitleaks
# cannot catch either shape. The glob covers the next split by construction.
_tech-debt*.md

# n8n migration artifacts
n8n-migration/
*.n8n.json
workflow-*.json

# Legacy database exports
*_backup.dump
*_backup.sql
schema_backup.sql

# Database backups (scripts/backup-db.sh, and the dev compose `backup` profile).
# These are FULL dumps of real chat history — private messages, usernames, chat
# titles, admin ids. gitleaks cannot save you here: a dump has no credential
# shape, so a clean scan says nothing about it. Encrypted or not, it never
# belongs in a public repository.
backups/
*.dump
*.dump.age
*.manifest.json

# Internal notes and planning
.internal/
internal/
migration-notes/

# Manual QA tests (contain chat IDs, bot IDs, test account details)
tests/manual/

# Playwright MCP artifacts
.playwright-mcp/

# Test screenshots
tests/manual/screenshots/

# Plan-orchestration raw payloads (raw `claude -p` output may contain auth tokens — TD-021)
# Keep the *.execution.md envelopes and *.log.jsonl audit trails tracked; ignore only raw dumps.
*.execution.md.raw/
docs/plans/.draft/
